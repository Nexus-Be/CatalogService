# =============================================================================
# ENVIRONMENT VARIABLES FOR CATALOG SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
CATALOG_SERVICE_PORT=8002

# Database Connection (Neon Cloud PostgreSQL & Local Fallback)
CONNECTION_STRING=Host=ep-icy-salad-az7mdfqt-pooler.c-3.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
CATALOG_CONNECTION_STRING=Host=ep-icy-salad-az7mdfqt-pooler.c-3.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
CATALOG_DB_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_CATALOG_DB_PASSWORD>

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
