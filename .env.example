# =============================================================================
# ENVIRONMENT VARIABLES FOR CATALOG SERVICE (.env.example)
# =============================================================================
# Hỗ trợ 2 hồ sơ môi trường:
#   1. Local DB (PostgreSQL Cục bộ port 5434): cp .env.local.example .env
#   2. Server DB (PostgreSQL Neon Cloud):      cp .env.server.example .env
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
CATALOG_SERVICE_PORT=8002

# Database Connection (Mặc định Local DB)
CONNECTION_STRING=Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=postgres
CATALOG_CONNECTION_STRING=Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=postgres
CATALOG_DB_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
