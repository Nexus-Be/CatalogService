# =============================================================================
# ENVIRONMENT VARIABLES FOR CATALOG SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
CATALOG_SERVICE_PORT=8002
CATALOG_DB_PORT=5434

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-red-credit-b3806kao-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
CATALOG_CONNECTION_STRING=Host=ep-red-credit-b3806kao-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
