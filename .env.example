# =============================================================================
# ENVIRONMENT VARIABLES FOR CATALOG SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
CATALOG_SERVICE_PORT=8002

# Database Connection (Local PostgreSQL - Port 5434)
CONNECTION_STRING=Host=localhost;Port=5434;Database=catalog_db;Username=postgres;Password=postgres
CATALOG_CONNECTION_STRING=Host=localhost;Port=5434;Database=catalog_db;Username=postgres;Password=postgres
CATALOG_DB_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
