{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=<REPLACE_WITH_DB_PASSWORD>"
  },
  "RabbitMq": {
    "UseInMemory": true,
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "<REPLACE_WITH_RABBITMQ_PASSWORD>"
  },
  "Otel": {
    "Endpoint": "http://localhost:4317"
  },
  "Cloudinary": {
    "CloudName": "your_cloud_name",
    "ApiKey": "your_api_key",
    "ApiSecret": "your_api_secret"
  }
}
