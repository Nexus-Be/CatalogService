@Host = http://localhost:5099
@ElectronicsId = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
@ProductId = 22222222-2222-2222-2222-000000000001
@SellerId = 11111111-1111-1111-1111-000000000004

### 1. Health Check
GET {{Host}}/health
Accept: application/json

### 2. List Categories
GET {{Host}}/api/v1/catalog/categories
Accept: application/json

### 3. Get Category by ID
GET {{Host}}/api/v1/catalog/categories/{{ElectronicsId}}
Accept: application/json

### 4. Create Category
POST {{Host}}/api/v1/catalog/categories
Content-Type: application/json

{
  "name": "Màn Hình Máy Tính",
  "description": "Màn hình 2K, 4K, 144Hz cho đồ họa và gaming",
  "parentId": "{{ElectronicsId}}",
  "level": 2,
  "sortOrder": 3
}

### 5. Update Category
PUT {{Host}}/api/v1/catalog/categories/{{ElectronicsId}}
Content-Type: application/json

{
  "name": "Thiết Bị Điện Tử & Công Nghệ",
  "description": "Điện thoại, máy tính bảng, phụ kiện thông minh",
  "level": 1,
  "sortOrder": 1,
  "isDisabled": false
}

### 6. Delete Category
DELETE {{Host}}/api/v1/catalog/categories/bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
Accept: application/json

### 7. List Products (Pagination)
GET {{Host}}/api/v1/catalog/products?page=1&pageSize=10
Accept: application/json

### 8. List Products by Category
GET {{Host}}/api/v1/catalog/products?page=1&pageSize=10&categoryId=cccccccc-cccc-cccc-cccc-cccccccccccc
Accept: application/json

### 9. Get Product by ID
GET {{Host}}/api/v1/catalog/products/{{ProductId}}
Accept: application/json

### 10. List Products by Seller
GET {{Host}}/api/v1/catalog/products/seller/{{SellerId}}
Accept: application/json

### 11. Create Product
POST {{Host}}/api/v1/catalog/products
Content-Type: application/json

{
  "sellerId": "{{SellerId}}",
  "categoryId": "{{ElectronicsId}}",
  "name": "Màn Hình Nexus Gaming Curved 27 inch 165Hz",
  "description": "Tấm nền Fast IPS, 1ms, HDR400, độ cong 1500R",
  "brand": "Nexus Display"
}

### 12. Update Product
PUT {{Host}}/api/v1/catalog/products/{{ProductId}}
Content-Type: application/json

{
  "name": "Bàn phím cơ không dây Nexus Pro Wireless V2",
  "description": "Nâng cấp switch Gateron Yellow Pro pre-lubed",
  "brand": "Nexus Tech",
  "status": "Active"
}

### 13. Delete Product
DELETE {{Host}}/api/v1/catalog/products/{{ProductId}}
Accept: application/json

### 14. Get Product Inventory
GET {{Host}}/api/v1/catalog/inventory/{{ProductId}}
Accept: application/json

### 15. Adjust Inventory (+20 items)
POST {{Host}}/api/v1/catalog/inventory/{{ProductId}}/adjust
Content-Type: application/json

{
  "quantityChange": 20
}
