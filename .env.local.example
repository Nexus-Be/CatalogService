# =============================================================================
# NEXUS CATALOG SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
CATALOG_SERVICE_PORT=8002

# Database (Neon Cloud PostgreSQL)
CATALOG_DB_CONNECTION=Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=postgres

# Downstream service URLs
FULFILLMENT_SERVICE_URL=http://localhost:8006

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
