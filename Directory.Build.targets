<Project>
  <Target Name="AutoSignDlls" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$cert = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -match 'CatalogDev' } | Select-Object -First 1; if ($cert) { Get-ChildItem -Path '$(TargetDir)*.dll' | ForEach-Object { Set-AuthenticodeSignature -FilePath $_.FullName -Certificate $cert | Out-Null } }&quot;" IgnoreExitCode="true" ContinueOnError="true" />
  </Target>
</Project>
